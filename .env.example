# Discord credentials
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id

# OpenRouter settings
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Bot behavior
MAX_HISTORY=8
MAX_TOKENS=1000
TEMPERATURE=0.85
TOP_P=0.95
FREQUENCY_PENALTY=0.5
PRESENCE_PENALTY=0.3

# Premium Features
# Optional: For research mode with web search - get free tier at https://serper.dev
SERPER_API_KEY=your_serper_api_key_for_research_mode
