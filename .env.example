# Discord credentials
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id

# OpenRouter settings
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model is google/gemma-3-27b-it:free (free). Override for paid models:
# OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Bot behavior
MAX_HISTORY=8
MAX_TOKENS=1000
TEMPERATURE=0.85
TOP_P=0.95
FREQUENCY_PENALTY=0.5
PRESENCE_PENALTY=0.3
SYSTEM_PROMPT=You are a helpful and concise Discord assistant. Keep answers friendly and practical.

# Reliability / safety tuning (all optional)
MAX_PROMPT_CHARS=4000
MAX_CODE_CHARS=6000
COOLDOWN_MS=4000
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LOG_LEVEL=info
# DATA_DIR=./data

# Premium Features
# Optional: Serper for best research quality. Without it, free DuckDuckGo fallback is used (zero cost).
# SERPER_API_KEY=your_serper_api_key_for_research_mode
