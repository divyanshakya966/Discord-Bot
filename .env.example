# Discord credentials
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
# Optional: set ONE guild id for instant slash-command testing (global commands take minutes to propagate)
# DISCORD_GUILD_ID=your_test_server_id

# OpenRouter settings
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model is nvidia/nemotron-3-super-120b-a12b:free (verified free). Override:
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Bot behavior
MAX_HISTORY=8
MAX_TOKENS=1000
TEMPERATURE=0.85
TOP_P=0.95
FREQUENCY_PENALTY=0.5
PRESENCE_PENALTY=0.3
SYSTEM_PROMPT=You are a helpful and concise Discord assistant. Keep answers friendly and practical.

# Reliability / safety tuning (all optional)
MAX_PROMPT_CHARS=4000
MAX_CODE_CHARS=6000
COOLDOWN_MS=4000
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LOG_LEVEL=info
# LOG_FORMAT=pretty  # pretty|json (default pretty locally, json in production)
# LOG_FILE=./data/bot.log  # optional file logging with rotation
# LOG_MAX_BYTES=5242880
# LOG_MAX_FILES=5
# DATA_DIR=./data

# Premium Features
# Optional: Serper for best research quality. Without it, free DuckDuckGo fallback is used (zero cost).
# SERPER_API_KEY=your_serper_api_key_for_research_mode
